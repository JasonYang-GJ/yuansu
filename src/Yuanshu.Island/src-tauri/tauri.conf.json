{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yuanshu Island",
  "version": "0.8.0",
  "identifier": "com.yuanshu.island",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "元枢灵动岛",
        "width": 296,
        "height": 54,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "panel",
        "title": "元枢灵动岛 · 任务与设置",
        "url": "index.html?panel=1",
        "width": 600,
        "height": 720,
        "minWidth": 420,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "backgroundColor": "#12202aff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "shortDescription": "元枢内置桌面灵动岛",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
