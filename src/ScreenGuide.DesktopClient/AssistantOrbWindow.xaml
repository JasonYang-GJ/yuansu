<Window x:Class="ScreenGuide.DesktopClient.AssistantOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="元枢悬浮助手" Width="304" Height="320"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" AutomationProperties.AutomationId="AssistantOrb"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing"
        KeyboardNavigation.TabNavigation="Cycle" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="OrbAction" TargetType="Button">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#233C50" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#A8BECF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E7F4FC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#D0EAF9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#185EC3" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#617487" />
                                <Setter TargetName="Surface" Property="Background" Value="#EAF0F4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10,8,10,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="86" />
            <RowDefinition Height="23" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <Border Background="#FAFDFF" CornerRadius="12" Padding="14,10,14,12">
            <Border.Effect>
                <DropShadowEffect Color="#173D59" BlurRadius="12" ShadowDepth="3" Opacity="0.2" />
            </Border.Effect>
            <StackPanel>
                <Grid Height="22" Margin="0,0,0,5">
                    <TextBlock Text="元枢" Foreground="#50667B" FontSize="11" VerticalAlignment="Center" />
                    <Thumb x:Name="OrbDragHandle" Width="70" Height="22" HorizontalAlignment="Right"
                           Cursor="SizeAll" Focusable="True" IsTabStop="True" TabIndex="5"
                           AutomationProperties.AutomationId="OrbMove" AutomationProperties.Name="移动悬浮助手"
                           ToolTip="拖动移动；聚焦后用方向键微调位置"
                           DragDelta="OrbDragHandle_DragDelta" KeyDown="OrbDragHandle_KeyDown">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="Grip" Background="Transparent" CornerRadius="4"
                                        BorderThickness="1" BorderBrush="Transparent">
                                    <Path Data="M 0,0 L 22,0 M 0,4 L 22,4 M 0,8 L 22,8"
                                          Stroke="#617D93" StrokeThickness="1.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="#E7F4FC" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Grip" Property="BorderBrush" Value="#185EC3" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
                <TextBlock x:Name="OrbStatus" Text="语音已暂停" FontSize="15" FontWeight="SemiBold"
                           Foreground="#234761" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="OrbStatus" />
                <TextBlock x:Name="OrbDetail" Text="点击下方小球开始语音对话。" Margin="0,6,0,0"
                           FontSize="12" Foreground="#364F63" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineHeight="20" LineStackingStrategy="BlockLineHeight" MaxHeight="60"
                           AutomationProperties.AutomationId="OrbDetail" />
            </StackPanel>
        </Border>
        <Button x:Name="OrbVoiceToggle" Grid.Row="2" Width="84" Height="84" TabIndex="0"
                HorizontalAlignment="Center" Background="#F6FCFF" Foreground="#185EC3"
                BorderBrush="#659BBE" BorderThickness="2" Cursor="Hand"
                AutomationProperties.AutomationId="OrbVoiceToggle" AutomationProperties.Name="开始语音"
                ToolTip="开始语音：本次打开期间使用麦克风；再次点击暂停"
                Click="OrbVoiceToggle_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="OrbSurface" Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#173D59" BlurRadius="12" ShadowDepth="3" Opacity="0.2" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Image Source="/ScreenGuide.DesktopClient;component/Assets/yuanshu-icon.png"
                               Width="64" Height="64" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OrbSurface" Property="Fill" Value="#DFF4FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OrbSurface" Property="Fill" Value="#C1E8FF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="OrbSurface" Property="Stroke" Value="#185EC3" />
                            <Setter TargetName="OrbSurface" Property="StrokeThickness" Value="4" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OrbSurface" Property="Fill" Value="#EAF0F4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Border Grid.Row="3" Background="#FAFDFF" CornerRadius="8" Padding="8,2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <TextBlock x:Name="VoiceToggleLabel" Text="开始语音" FontSize="11" Foreground="#233C50" />
        </Border>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="OrbStopRequest" Content="停止" Style="{StaticResource OrbAction}" TabIndex="1"
                    AutomationProperties.AutomationId="OrbStopRequest" AutomationProperties.Name="停止当前请求"
                    ToolTip="停止当前请求和播报" Click="OrbStopRequest_Click" IsEnabled="False" />
            <Button x:Name="OrbDashboard" Content="管理" Style="{StaticResource OrbAction}" Margin="8,0" TabIndex="2"
                    AutomationProperties.AutomationId="OrbDashboard" AutomationProperties.Name="打开管理窗口"
                    ToolTip="打开对话、任务和设置；需要确认的操作也在此处理" Click="OrbDashboard_Click" />
            <Button x:Name="OrbMemories" Content="记忆" Style="{StaticResource OrbAction}" MinWidth="52" Margin="0,0,8,0" TabIndex="3"
                    AutomationProperties.AutomationId="OrbMemories" AutomationProperties.Name="打开我的记忆"
                    ToolTip="查看、保存和查找你明确保存的本机记忆" Click="OrbMemories_Click" />
            <Button x:Name="OrbExit" Content="退出" Style="{StaticResource OrbAction}" TabIndex="4"
                    AutomationProperties.AutomationId="OrbExit" AutomationProperties.Name="退出元枢"
                    ToolTip="退出元枢，关闭麦克风和播报" Click="OrbExit_Click" />
        </StackPanel>
    </Grid>
</Window>
