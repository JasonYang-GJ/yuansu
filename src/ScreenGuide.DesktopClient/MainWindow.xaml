<Window x:Class="ScreenGuide.DesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="元枢" Width="1360" Height="860" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>
            <StackPanel Margin="25,22,18,0">
                <TextBlock Text="元枢" Foreground="White" FontFamily="Microsoft YaHei UI"
                           FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="电脑工作助手" Foreground="#8FA1A9" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1">
                <Button x:Name="DashboardNavButton" Content="首页" Tag="Selected" Style="{StaticResource NavButton}"
                        Click="NavigationButton_Click" CommandParameter="Dashboard" />
                <Button x:Name="ConversationsNavButton" Content="对话" Style="{StaticResource NavButton}"
                        Click="NavigationButton_Click" CommandParameter="Conversations" />
                <Button x:Name="ProjectsNavButton" Content="项目" Style="{StaticResource NavButton}"
                        Click="NavigationButton_Click" CommandParameter="Projects" />
                <Button x:Name="DesktopActionsNavButton" Content="电脑操作" Visibility="Collapsed" Style="{StaticResource NavButton}"
                        Click="NavigationButton_Click" CommandParameter="DesktopActions" />
                <Button x:Name="NewTaskNavButton" Content="编程任务" Style="{StaticResource NavButton}"
                        Click="NavigationButton_Click" CommandParameter="NewTask" />
                <Button x:Name="CurrentTaskNavButton" Content="当前任务" Style="{StaticResource NavButton}"
                        Click="NavigationButton_Click" CommandParameter="CurrentTask" />
                <Button x:Name="HistoryNavButton" Content="任务历史" Style="{StaticResource NavButton}"
                        Click="NavigationButton_Click" CommandParameter="History" />
                <Button x:Name="SettingsNavButton" Content="设置" Style="{StaticResource NavButton}"
                        Click="NavigationButton_Click" CommandParameter="Settings" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="25,0,18,18" VerticalAlignment="Bottom">
                <TextBlock Text="YUANSHU V2 · 阶段 1" Foreground="#71858E" FontFamily="Consolas" FontSize="11" />
                <TextBlock Text="本机执行 · 证据优先" Foreground="#8FA1A9" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitleText" Text="首页" FontFamily="Segoe UI Variable Display"
                               FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border x:Name="HostStatusPill" Grid.Column="1" Background="#EAF6F0" CornerRadius="12" Padding="10,5"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="HostStatusText" Text="本机中枢连接中" Foreground="{StaticResource SuccessBrush}" FontSize="12" />
                    </Border>
                    <Button x:Name="ReturnToAssistantButton" Grid.Column="5" Content="返回悬浮球" Visibility="Collapsed"
                            VerticalAlignment="Center" Click="ReturnToAssistantButton_Click"
                            AutomationProperties.AutomationId="ReturnToAssistant" />
                    <Border x:Name="CodexStatusPill" Grid.Column="3" Visibility="Collapsed" Background="#EDF2FA" CornerRadius="12" Padding="10,5"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CodexStatusText" Text="Codex 检查中" Foreground="{StaticResource BrandBrush}" FontSize="12" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ErrorBanner" Grid.Row="1" Visibility="Collapsed" Margin="22,12,22,0"
                    Background="#FCECED" BorderBrush="#E3A1A5" BorderThickness="1" CornerRadius="4" Padding="13,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ErrorMessageText" FontWeight="SemiBold" Foreground="#8E2F36" />
                        <Expander Header="查看技术详情" Foreground="#8E2F36" Margin="0,5,0,0">
                            <TextBlock x:Name="ErrorTechnicalText" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </Expander>
                    </StackPanel>
                    <Button Grid.Column="1" Content="关闭" Style="{StaticResource SecondaryButton}" Padding="10,4"
                            MinHeight="28" Click="CloseErrorButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="22,16,22,18">
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SurfaceBorder}" Background="#EAF4F2" BorderBrush="#B7D8D0" Padding="30,26">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="66" Height="66" CornerRadius="33" Background="#D8ECE7">
                                        <Border x:Name="VoiceStateDot" Width="22" Height="22" CornerRadius="11"
                                                Background="#1F8A6A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="VoiceStateText" Text="语音未开启"
                                                   FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.AutomationId="VoiceState" />
                                        <TextBlock x:Name="VoicePrivacyText"
                                                   Text="点击“开始语音”后使用麦克风在本机识别。停止语音或关闭窗口即结束，也可在对话页打字。"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="StartVoiceButton" Content="开始语音" Style="{StaticResource PrimaryButton}"
                                                    Click="StartVoiceButton_Click" AutomationProperties.AutomationId="StartVoice" />
                                            <Button x:Name="StopVoiceButton" Content="停止语音" Margin="10,0,0,0" IsEnabled="False"
                                                    Style="{StaticResource SecondaryButton}" Click="StopVoiceButton_Click"
                                                    AutomationProperties.AutomationId="StopVoice" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="VoiceTranscriptBorder" Grid.Row="1" Margin="84,18,0,0" Padding="16,13"
                                        Background="#F8FCFB" BorderBrush="#C9DED9" BorderThickness="1" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="最近听到" Style="{StaticResource Eyebrow}" />
                                        <TextBlock x:Name="VoiceTranscriptText" Text="开启语音后，可以直接说出指令。" Margin="0,5,0,0"
                                                   FontSize="16" TextWrapping="Wrap" Foreground="#52656D" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="SessionHeaderBorder" Grid.Row="2" Margin="0,16,0,0" Padding="16"
                                        Background="#F8FCFB" BorderBrush="#C9DED9" BorderThickness="1" CornerRadius="6"
                                        AutomationProperties.AutomationId="SessionHeader">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="SessionTitleText" Text="还没有开始话题"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       AutomationProperties.AutomationId="SessionTitle" />
                                            <TextBlock x:Name="SessionStatusText" Text="直接说出你想聊或想做的事情"
                                                       Foreground="#52656D" Margin="0,4,0,0"
                                                       AutomationProperties.AutomationId="SessionStatus" />
                                            <TextBlock x:Name="SessionProjectText" Text="未选择项目"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button x:Name="StopSessionButton" Grid.Column="1" Content="停止当前请求"
                                                Style="{StaticResource DangerButton}" Visibility="Collapsed"
                                                Click="StopSessionButton_Click"
                                                AutomationProperties.AutomationId="StopSession" />
                                        <Button x:Name="NewTopicButton" Grid.Column="3" Content="新话题"
                                                Style="{StaticResource SecondaryButton}" Click="NewTopicButton_Click"
                                                AutomationProperties.AutomationId="NewTopic" />
                                    </Grid>
                                </Border>

                                <ContentControl x:Name="AssistantPlanBorder" Grid.Row="3" Visibility="Collapsed"
                                        Margin="0,16,0,0" Padding="16"
                                        Background="White" BorderBrush="#8FC5B8" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="继续刚才的请求" Style="{StaticResource Eyebrow}"
                                                       AutomationProperties.AutomationId="SessionContextCard" />
                                            <TextBlock x:Name="AssistantPlanSummaryText" FontSize="16" FontWeight="SemiBold"
                                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                                            <TextBlock x:Name="AssistantPlanDetailText" Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                                            <StackPanel x:Name="SessionProjectPickerPanel" Visibility="Collapsed"
                                                        Orientation="Horizontal" Margin="0,10,0,0">
                                                <ComboBox x:Name="SessionProjectComboBox" MinWidth="260"
                                                          DisplayMemberPath="Name"
                                                          AutomationProperties.AutomationId="SessionProjectPicker" />
                                            </StackPanel>
                                            <StackPanel x:Name="SessionFilePickerPanel" Visibility="Collapsed"
                                                        Margin="0,8,0,0">
                                                <TextBlock Text="文件只用于这一次请求；选择后仍会让你确认。"
                                                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="CancelSessionContextButton" Content="取消这条请求"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="CancelAssistantPlanButton_Click"
                                                AutomationProperties.AutomationId="CancelSessionContext" />
                                        <Button x:Name="ConfirmAssistantPlanButton" Grid.Column="3" Content="确认这一次"
                                                Style="{StaticResource PrimaryButton}" Click="ConfirmAssistantPlanButton_Click"
                                                AutomationProperties.AutomationId="ContinueSessionContext" />
                                    </Grid>
                                </ContentControl>

                                <Border x:Name="WindowObservationBorder" Grid.Row="4" Visibility="Collapsed"
                                        Margin="0,14,0,0" Padding="14" CornerRadius="6"
                                        Background="#FFF6E8" BorderBrush="#E8C47D" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#D98B2B"
                                                VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="正在查看你确认的单个窗口" FontWeight="SemiBold" />
                                            <TextBlock x:Name="WindowObservationTargetText"
                                                       Text="画面只在本机内存中识别，不会保存或上传。"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="停止查看" Style="{StaticResource SecondaryButton}"
                                                Padding="14,6" Click="StopWindowObservationButton_Click" />
                                    </Grid>
                                </Border>

                                <Border x:Name="AssistantResultBorder" Grid.Row="5" Visibility="Collapsed"
                                        Margin="0,14,0,0" Padding="16" CornerRadius="6"
                                        Background="#F7FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="AssistantResultStatusText" Text="处理结果" Style="{StaticResource Eyebrow}" />
                                        <TextBlock x:Name="AssistantResultText" Margin="0,5,0,0" FontSize="15"
                                                   TextWrapping="Wrap" />
                                        <Button x:Name="ReadAssistantResultButton" Content="朗读结果" Margin="0,12,0,0"
                                                HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                                                Padding="14,6" Click="ReadAssistantResultButton_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="SessionMessagesBorder" Style="{StaticResource SurfaceBorder}"
                                Margin="0,14,0,0" Padding="18" Visibility="Collapsed"
                                AutomationProperties.AutomationId="SessionMessages">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="当前话题" FontSize="16" FontWeight="SemiBold" />
                                <ListBox x:Name="SessionMessagesList" Grid.Row="1" Margin="0,10,0,0"
                                         MaxHeight="360" BorderThickness="0" Background="Transparent"
                                         HorizontalContentAlignment="Stretch"
                                         AutomationProperties.AutomationId="SessionMessagesList">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="14,11"
                                                    Margin="{Binding Margin}" MaxWidth="880"
                                                    HorizontalAlignment="{Binding Alignment}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding RoleText}" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,5,0,0"
                                                               FontSize="14" LineHeight="22" />
                                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SurfaceBorder}" Margin="0,14,0,0" Padding="0,16">
                            <UniformGrid Columns="6">
                                <StackPanel Margin="18,0">
                                    <TextBlock Text="正在执行" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="ActiveCountText" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="18,0">
                                    <TextBlock Text="等待你决定" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="WaitingCountText" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="18,0">
                                    <TextBlock Text="授权项目" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="ProjectCountText" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="18,0">
                                    <TextBlock Text="今日完成" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="TodayCompletedCountText" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="18,0">
                                    <TextBlock Text="失败 / 中断" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="FailedCountText" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="18,0">
                                    <TextBlock Text="语音中枢" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="DashboardCodexVersionText" Text="检查中" FontSize="15"
                                               FontWeight="SemiBold" Margin="0,8,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SurfaceBorder}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="当前工作" FontSize="16" FontWeight="SemiBold" />
                                    <ListBox x:Name="DashboardActiveList" Grid.Row="1" Margin="0,10,0,0" BorderThickness="0"
                                             MouseDoubleClick="TaskList_MouseDoubleClick" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SurfaceBorder}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="最近任务" FontSize="16" FontWeight="SemiBold" />
                                    <ListBox x:Name="DashboardRecentList" Grid.Row="1" Margin="0,10,0,0" BorderThickness="0"
                                             MouseDoubleClick="TaskList_MouseDoubleClick" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ConversationsPage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SurfaceBorder}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Content="新对话" Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.AutomationId="NewConversation"
                                    HorizontalAlignment="Stretch" Click="NewConversationButton_Click" />
                            <ListBox x:Name="ConversationListBox" Grid.Row="2" BorderThickness="0"
                                     SelectionChanged="ConversationListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,7">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SurfaceBorder}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Padding="20,15" Background="#F7FAFB" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="ConversationTitleText" Text="和元枢聊一聊"
                                                   FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ConversationStateText" Text="新建对话后即可开始"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#EAF6F0" CornerRadius="12" Padding="11,5"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="只聊天 · 不操作电脑" Foreground="#1F7A61" FontSize="12" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <StackPanel x:Name="ConversationEmptyPanel" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" MaxWidth="560">
                                    <TextBlock Text="从一个问题开始" FontSize="24" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="这里适合讨论、解释和整理想法，不会读取项目、运行命令或操作电脑。"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,9,0,18" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="去创建开发任务" Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0" Click="ConversationOpenTaskButton_Click" />
                                        <Button Content="去电脑操作" Style="{StaticResource SecondaryButton}"
                                                Click="ConversationOpenActionsButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <DockPanel x:Name="ConversationMessagesPanel" Visibility="Collapsed">
                                    <Button x:Name="LoadEarlierMessagesButton" DockPanel.Dock="Top"
                                            Content="加载更早消息" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Center" Margin="0,10,0,0"
                                            AutomationProperties.AutomationId="LoadEarlierMessages"
                                            Click="LoadEarlierMessagesButton_Click" />
                                <ListBox x:Name="ConversationMessagesList" Margin="18,8,18,14" BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="14,11"
                                                    Margin="{Binding Margin}" MaxWidth="760"
                                                    HorizontalAlignment="{Binding Alignment}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding RoleText}" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,5,0,0"
                                                               FontSize="14" LineHeight="22" />
                                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                </DockPanel>
                            </Grid>

                            <Border x:Name="MemoryOutboundConsentBorder" Grid.Row="2" Margin="16,0,16,12"
                                    Padding="14" CornerRadius="6" BorderThickness="1" BorderBrush="#E0A13B"
                                    Background="#FFF8E8" Visibility="Collapsed"
                                    AutomationProperties.AutomationId="MemoryOutboundConsent">
                                <StackPanel>
                                    <TextBlock Text="长期记忆出站确认（仅本 Turn 一次）"
                                               FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MemoryOutboundRouteText" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="MemoryOutboundProjectText" Margin="0,3,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                    <ItemsControl x:Name="MemoryOutboundItemsControl" Margin="0,9,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,7" Padding="10" Background="White"
                                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Body}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Metadata}" Margin="0,4,0,0" FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="MemoryOutboundBudgetText" Margin="0,2,0,0"
                                               TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock Text="以上完整内容将发送给当前冻结的 AI 服务。确认只对这一个 Turn 有效；取消、修改或过期后必须重新确认。"
                                               Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#80530B" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="不发送并取消" Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0" Click="DeclineMemoryOutboundButton_Click"
                                                AutomationProperties.AutomationId="DeclineMemoryOutbound" />
                                        <Button Content="确认发送这一次" Style="{StaticResource PrimaryButton}"
                                                Click="ConfirmMemoryOutboundButton_Click"
                                                AutomationProperties.AutomationId="ConfirmMemoryOutbound" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PointerAnswerConsentBorder" Grid.Row="3" Margin="16,0,16,12"
                                    Padding="14" CornerRadius="6" BorderThickness="1" BorderBrush="#4A86C5"
                                    Background="#EEF6FF" Visibility="Collapsed"
                                    AutomationProperties.AutomationId="PointerAnswerOutboundConsent">
                                <StackPanel>
                                    <TextBlock Text="指针区域文字出站确认（仅本 Turn 一次）"
                                               FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PointerAnswerRouteText" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="PointerAnswerPromptText" Margin="0,3,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="将发送的完整问题" Margin="0,10,0,3" FontWeight="SemiBold" />
                                    <TextBox x:Name="PointerAnswerQuestionText" IsReadOnly="True" TextWrapping="Wrap"
                                             Background="White" BorderBrush="{StaticResource LineBrush}" />
                                    <TextBlock Text="将发送的完整本机 OCR 文字" Margin="0,10,0,3" FontWeight="SemiBold" />
                                    <TextBox x:Name="PointerAnswerOcrText" IsReadOnly="True" TextWrapping="Wrap"
                                             Background="White" BorderBrush="{StaticResource LineBrush}" />
                                    <TextBlock x:Name="PointerAnswerShapeText" Margin="0,7,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="这是刚才识别的冻结文字，不是实时画面；不会发送图片、整页文字、窗口标题或文件路径。请在识别后 120 秒内阅读并确认；然后切回同一目标窗口，按 Ctrl+Alt+F8 发送这一次。不会再次读取图片。"
                                               Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#285A8A" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="不发送并取消" Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0" Click="DeclinePointerAnswerButton_Click"
                                                AutomationProperties.AutomationId="DeclinePointerAnswer" />
                                        <Button Content="确认发送这一次" Style="{StaticResource PrimaryButton}"
                                                Click="ConfirmPointerAnswerButton_Click"
                                                AutomationProperties.AutomationId="ConfirmPointerAnswer" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="4" Padding="16" Background="#F7FAFB" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <Border x:Name="PointerGesturePanel" Visibility="Collapsed" Background="#E7F1FF" Padding="10" Margin="0,0,0,8"
                                                AutomationProperties.AutomationId="PointerGesturePanel">
                                            <StackPanel>
                                                <TextBlock x:Name="PointerGestureInstruction" TextWrapping="Wrap" />
                                                <Button Content="取消这次指针操作" HorizontalAlignment="Right" Click="CancelPointerGestureButton_Click"
                                                        AutomationProperties.AutomationId="CancelPointerGesture" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="本 Turn 可选记忆（默认 0 条，不会自动发送；按 Ctrl 可多选，最多 8 条）"
                                                   FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        <ListBox x:Name="ConversationMemorySelectionList" Margin="0,6,0,0" MaxHeight="92"
                                                 SelectionMode="Extended" BorderBrush="{StaticResource LineBrush}"
                                                 SelectionChanged="ConversationMemorySelectionList_SelectionChanged"
                                                 AutomationProperties.AutomationId="ConversationMemorySelection">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="4,3">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                    <TextBox Grid.Row="2" x:Name="ConversationInputTextBox" MinHeight="74" MaxHeight="150"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             IsEnabled="False" TextChanged="ConversationInputTextBox_TextChanged"
                                             AutomationProperties.AutomationId="ConversationInput" />
                                    <Grid Grid.Row="4">
                                        <TextBlock Text="记忆只有在你查看完整内容并确认后，才会发送给本 Turn 冻结的 Provider"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="StopConversationButton" Content="停止回答"
                                                    Style="{StaticResource DangerButton}" Visibility="Collapsed"
                                                    Margin="0,0,8,0" Click="StopConversationButton_Click" />
                                            <Button x:Name="AskPointerQuestionButton" Content="询问指针位置"
                                                    Style="{StaticResource SecondaryButton}" IsEnabled="False"
                                                    Margin="0,0,8,0" Click="AskPointerQuestionButton_Click"
                                                    AutomationProperties.AutomationId="AskPointerQuestion" />
                                            <Button x:Name="SendConversationButton" Content="发送"
                                                    Style="{StaticResource PrimaryButton}" IsEnabled="False"
                                                    Click="SendConversationButton_Click"
                                                    AutomationProperties.AutomationId="SendConversation" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="ProjectsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="项目" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="只管理你明确选择并授权的 Git 项目，不会扫描硬盘。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Content="添加项目" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                Click="AddProjectButton_Click" />
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource SurfaceBorder}" Padding="12">
                        <ListView x:Name="ProjectsListView" SelectionChanged="ProjectsListView_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="项目名称" DisplayMemberBinding="{Binding Name}" Width="180" />
                                    <GridViewColumn Header="目录" DisplayMemberBinding="{Binding RootPath}" Width="390" />
                                    <GridViewColumn Header="Git 状态" DisplayMemberBinding="{Binding GitStatus}" Width="180" />
                                    <GridViewColumn Header="授权" DisplayMemberBinding="{Binding AuthorizationState}" Width="100" />
                                    <GridViewColumn Header="最近任务" DisplayMemberBinding="{Binding RecentTaskCount}" Width="90" />
                                    <GridViewColumn Header="正在执行" DisplayMemberBinding="{Binding ActiveText}" Width="90" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <Border Grid.Row="3" Style="{StaticResource SurfaceBorder}" Margin="0,12,0,0" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedProjectDetailText" Text="选择项目查看详情。" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <Button x:Name="RevokeProjectButton" Grid.Column="1" Content="删除授权" Style="{StaticResource DangerButton}"
                                    IsEnabled="False" Click="RevokeProjectButton_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="NewTaskPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Text="新建任务" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="仅用于代码项目；编程助手会在你授权的项目范围内工作。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18" />
                        <Border Style="{StaticResource SurfaceBorder}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="选择项目" FontWeight="SemiBold" />
                                <ComboBox x:Name="NewTaskProjectComboBox" DisplayMemberPath="Name" Margin="0,7,0,0"
                                          SelectionChanged="NewTaskProjectComboBox_SelectionChanged" />
                                <Border Background="#FFF7E6" BorderBrush="#E4C47C" BorderThickness="1" CornerRadius="4"
                                        Padding="12" Margin="0,12,0,0">
                                    <TextBlock x:Name="TaskDirectoryNoticeText" Text="编程助手将在所选项目目录内执行任务。" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="任务标题（可选）" FontWeight="SemiBold" Margin="0,16,0,7" />
                                <TextBox x:Name="NewTaskTitleTextBox" />
                                <TextBlock Text="希望电脑完成什么" FontWeight="SemiBold" Margin="0,16,0,7" />
                                <TextBox x:Name="NewTaskInstructionTextBox" MinHeight="150" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                <Button x:Name="NewTaskSubmitButton" Content="确认并开始任务" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right" Margin="0,16,0,0" Click="NewTaskSubmitButton_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DesktopActionsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Text="电脑操作" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="只执行你当次明确确认的低风险启动操作，不会移动鼠标、输入内容或执行系统命令。"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18" TextWrapping="Wrap" />

                        <Border Style="{StaticResource SurfaceBorder}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="打开已知应用" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="应用来自内置受控清单，不能输入程序路径或启动参数。"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DesktopApplicationComboBox" DisplayMemberPath="DisplayName" />
                                    <Button x:Name="OpenDesktopApplicationButton" Grid.Column="2" Content="确认后打开"
                                            Style="{StaticResource PrimaryButton}" Click="OpenDesktopApplicationButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfaceBorder}" Padding="22" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="打开安全网站" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="当前只允许 https 地址。每次打开前都会显示完整地址并请你确认。"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DesktopWebsiteTextBox" Text="https://" />
                                    <Button x:Name="OpenDesktopWebsiteButton" Grid.Column="2" Content="确认后打开"
                                            Style="{StaticResource PrimaryButton}" Click="OpenDesktopWebsiteButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DesktopActionResultBorder" Style="{StaticResource SurfaceBorder}"
                                Background="#EAF6F0" BorderBrush="#79B79C" Padding="16" Margin="0,12,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="DesktopActionResultText" TextWrapping="Wrap" />
                        </Border>

                        <Border Background="#FFF7E6" BorderBrush="#E4C47C" BorderThickness="1"
                                CornerRadius="4" Padding="14" Margin="0,12,0,0">
                            <TextBlock Text="当前不会执行：任意程序路径、命令行、鼠标点击、键盘输入、发送消息、删除文件、付款或账号设置。"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="CurrentTaskPage" Visibility="Collapsed">
                    <Grid x:Name="CurrentTaskEmptyPanel">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="当前没有正在查看的任务" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="从首页创建任务，或从任务历史中选择一项。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16" />
                            <Button Content="新建任务" Style="{StaticResource PrimaryButton}" Click="OpenNewTaskButton_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="CurrentTaskContent" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CurrentTaskTitleText" Style="{StaticResource SectionTitle}" Text="任务" />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <TextBlock x:Name="CurrentTaskStatusText" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CurrentTaskDurationText" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" />
                                    <TextBlock x:Name="CurrentTaskProjectText" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="CurrentTaskCancelButton" Grid.Column="1" Content="取消任务" Style="{StaticResource DangerButton}"
                                    Click="CurrentTaskCancelButton_Click" />
                        </Grid>
                        <Border x:Name="CurrentVerificationBanner" Grid.Row="1" Margin="0,14,0,0" Padding="16,13"
                                Background="#EEF3F5" BorderBrush="#B8CBD3" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="系统验证结果" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="CurrentVerificationStatusText" Text="等待证据" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="CurrentUserSummaryText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="15" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2">
                            <Border x:Name="EvidenceConflictBanner" Visibility="Collapsed" Margin="0,10,0,0" Padding="12"
                                    Background="#FCECED" BorderBrush="#E3A1A5" BorderThickness="1" CornerRadius="4">
                                <TextBlock Text="编程助手已完成执行，但系统验证未通过。" Foreground="#972F37" FontWeight="Bold" />
                            </Border>
                            <Border x:Name="DecisionCard" Visibility="Collapsed" Margin="0,10,0,0" Padding="14"
                                    Background="#FFF7E6" BorderBrush="#E4C47C" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock x:Name="DecisionQuestionText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="DecisionAnswerTextBox" MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap" />
                                        <Button Grid.Column="2" Content="继续任务" Style="{StaticResource PrimaryButton}" Click="ContinueTaskButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.04*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0.96*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SurfaceBorder}" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="执行过程" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CurrentInstructionText" Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="{StaticResource MutedBrush}" />
                                    <ListBox x:Name="CurrentEventsList" Grid.Row="2" BorderThickness="0" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SurfaceBorder}" Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="可信结果" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="EvidenceStatsText" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <TextBlock Text="修改文件" FontWeight="SemiBold" Margin="0,15,0,6" />
                                        <ListBox x:Name="ChangedFilesList" MinHeight="50" BorderThickness="0" />
                                        <TextBlock Text="实际测试" FontWeight="SemiBold" Margin="0,15,0,6" />
                                        <ListBox x:Name="TestCommandsList" MinHeight="50" BorderThickness="0" />
                                        <TextBlock Text="编程助手最终说明" FontWeight="SemiBold" Margin="0,15,0,6" />
                                        <TextBlock x:Name="AgentFinalExplanationText" TextWrapping="Wrap" />
                                        <Expander Header="技术信息" Margin="0,14,0,0">
                                            <TextBlock x:Name="TaskTechnicalInfoText" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,7,0,0" />
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="HistoryPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="任务历史" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="以系统证据筛选和查看过去的任务。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="HistoryFilterComboBox" HorizontalAlignment="Right" Width="170"
                                  SelectionChanged="HistoryFilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="全部历史" Tag="" IsSelected="True" />
                            <ComboBoxItem Content="成功" Tag="Succeeded" />
                            <ComboBoxItem Content="失败" Tag="Failed" />
                            <ComboBoxItem Content="已取消" Tag="Cancelled" />
                            <ComboBoxItem Content="等待用户" Tag="WaitingForUser" />
                            <ComboBoxItem Content="未验证" Tag="Unverified" />
                            <ComboBoxItem Content="验证失败" Tag="VerificationFailed" />
                        </ComboBox>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource SurfaceBorder}" Padding="12">
                        <ListView x:Name="HistoryListView" MouseDoubleClick="TaskList_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="任务" DisplayMemberBinding="{Binding Title}" Width="280" />
                                    <GridViewColumn Header="项目" DisplayMemberBinding="{Binding ProjectName}" Width="160" />
                                    <GridViewColumn Header="运行状态" DisplayMemberBinding="{Binding Status}" Width="120" />
                                    <GridViewColumn Header="验证状态" DisplayMemberBinding="{Binding VerificationStatus}" Width="140" />
                                    <GridViewColumn Header="开始时间" DisplayMemberBinding="{Binding TimeText}" Width="150" />
                                    <GridViewColumn Header="结果摘要" DisplayMemberBinding="{Binding UserSummary}" Width="360" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="设置" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="只显示当前版本真正生效的选项。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18" />
                        <Border Style="{StaticResource SurfaceBorder}" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="普通聊天大脑" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="选择首页连续对话使用的 AI 服务。保存后从下一轮普通聊天开始生效。"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14" TextWrapping="Wrap" />

                                <Border AutomationProperties.AutomationId="AiResponsibilityBoundary"
                                        Background="#F7FAFB" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="普通聊天" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="由下面选择的 Provider 和 Model 负责。"
                                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource LineBrush}" />
                                        <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                            <TextBlock Text="编程任务" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="编程任务仍由 Codex 负责。" Margin="0,5,0,0" FontWeight="SemiBold" />
                                            <TextBlock Text="切换普通聊天大脑不会更换 Codex，也不会改变项目权限。"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="AI 服务（Provider）" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Grid.Column="2" Text="聊天模型（Model）" Style="{StaticResource Eyebrow}" />
                                    <ComboBox x:Name="AiChatProviderComboBox" Grid.Row="1" Margin="0,6,0,0"
                                              TextSearch.TextPath="DisplayName"
                                              SelectionChanged="AiChatProviderComboBox_SelectionChanged"
                                              AutomationProperties.AutomationId="AiChatProvider"
                                              AutomationProperties.Name="普通聊天 Provider">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           AutomationProperties.Name="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <ComboBox x:Name="AiChatModelComboBox" Grid.Row="1" Grid.Column="2" Margin="0,6,0,0"
                                              TextSearch.TextPath="DisplayName"
                                              SelectionChanged="AiChatModelComboBox_SelectionChanged"
                                              AutomationProperties.AutomationId="AiChatModel"
                                              AutomationProperties.Name="普通聊天 Model">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           AutomationProperties.Name="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </Grid>
                                <Button x:Name="SaveAiChatRouteButton" Content="保存普通聊天大脑"
                                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                        Margin="0,12,0,0" IsEnabled="False"
                                        Click="SaveAiChatRouteButton_Click"
                                        AutomationProperties.AutomationId="SaveAiChatRoute" />

                                <Border Background="#EDF4FF" BorderBrush="#D6E4FF" BorderThickness="1"
                                        CornerRadius="4" Padding="14" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="数据去向" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AiDataDestinationText" Text="选择 Provider 后显示数据发送位置。"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="AiDataDestination" />
                                        <TextBlock Text="切换后，同一会话的既有历史和下一条消息会发送给所选 Provider。当前正在运行的回答不会切换。"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Separator Margin="0,16,0,14" />
                                <TextBlock Text="Provider 密钥" FontWeight="SemiBold" />
                                <TextBlock x:Name="AiCredentialStatusText" Text="状态：尚未读取"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"
                                           AutomationProperties.AutomationId="AiCredentialStatus" />
                                <TextBlock x:Name="AiCredentialNotRequiredText"
                                           Text="使用 Codex 登录账号，无需在元枢保存 Key。"
                                           Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"
                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="AiCredentialNotRequired" />
                                <StackPanel x:Name="AiCredentialRequiredPanel"
                                            AutomationProperties.AutomationId="AiCredentialRequiredPanel">
                                    <PasswordBox x:Name="AiCredentialPasswordBox" MinHeight="38" Padding="11,8"
                                                 PasswordChanged="AiCredentialPasswordBox_PasswordChanged"
                                                 AutomationProperties.AutomationId="AiCredentialPassword"
                                                 AutomationProperties.Name="Provider 密钥，只能设置，不能查看" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="SaveAiCredentialButton" Content="保存密钥"
                                                Style="{StaticResource PrimaryButton}" IsEnabled="False"
                                                Click="SaveAiCredentialButton_Click"
                                                AutomationProperties.AutomationId="SaveAiCredential" />
                                        <Button x:Name="DeleteAiCredentialButton" Content="删除密钥"
                                                Style="{StaticResource DangerButton}" Margin="10,0,0,0" IsEnabled="False"
                                                Click="DeleteAiCredentialButton_Click"
                                                AutomationProperties.AutomationId="DeleteAiCredential" />
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="CheckAiProviderHealthButton" Content="检查连接"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Margin="0,10,0,0" IsEnabled="False"
                                        Click="CheckAiProviderHealthButton_Click"
                                        AutomationProperties.AutomationId="CheckAiProviderHealth" />
                                <TextBlock x:Name="AiProviderHealthText" Text="连接状态：尚未检查"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="AiProviderHealthStatus" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="LocalMemorySection" Style="{StaticResource SurfaceBorder}" Padding="20" Margin="0,0,0,12"
                                AutomationProperties.AutomationId="LocalMemorySection">
                            <StackPanel>
                                <TextBlock Text="我的记忆" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="仅保存在本机；当前不会自动发送给模型。"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="MemoryLocalOnlyNotice" />
                                <TextBlock Text="点击“新增记忆”写下希望记住的内容，再点击保存。下面可按关键词查找；聊天时可在对话页选择本次要参考的记忆。"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <ListBox x:Name="MemoryListBox" MinHeight="230"
                                                 SelectionChanged="MemoryListBox_SelectionChanged"
                                                 AutomationProperties.AutomationId="MemoryList">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="3,5">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="11" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Content="新增记忆" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                                Click="NewMemoryButton_Click"
                                                AutomationProperties.AutomationId="NewMemory" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="类别" Style="{StaticResource Eyebrow}" />
                                                <ComboBox x:Name="MemoryCategoryComboBox" Margin="0,6,0,0"
                                                          AutomationProperties.AutomationId="MemoryCategory">
                                                    <ComboBoxItem Content="用户事实" Tag="UserFact" IsSelected="True" />
                                                    <ComboBoxItem Content="用户偏好" Tag="UserPreference" />
                                                    <ComboBoxItem Content="项目备注" Tag="ProjectNote" />
                                                    <ComboBoxItem Content="决定" Tag="Decision" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="作用域" Style="{StaticResource Eyebrow}" />
                                                <ComboBox x:Name="MemoryScopeComboBox" Margin="0,6,0,0"
                                                          SelectionChanged="MemoryScopeComboBox_SelectionChanged"
                                                          AutomationProperties.AutomationId="MemoryScope">
                                                    <ComboBoxItem Content="全局" Tag="Global" IsSelected="True" />
                                                    <ComboBoxItem Content="已授权项目" Tag="Project" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <ComboBox x:Name="MemoryProjectComboBox" Margin="0,10,0,0"
                                                  DisplayMemberPath="Name" Visibility="Collapsed"
                                                  AutomationProperties.AutomationId="MemoryProject" />
                                        <TextBlock Text="标题" Style="{StaticResource Eyebrow}" Margin="0,10,0,0" />
                                        <TextBox x:Name="MemoryTitleTextBox" MaxLength="80" Margin="0,6,0,0"
                                                 AutomationProperties.AutomationId="MemoryTitle" />
                                        <TextBlock Text="正文" Style="{StaticResource Eyebrow}" Margin="0,10,0,0" />
                                        <TextBox x:Name="MemoryBodyTextBox" MaxLength="2000" MinHeight="88"
                                                 AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,0"
                                                 AutomationProperties.AutomationId="MemoryBody" />
                                        <TextBlock Text="可选到期日期" Style="{StaticResource Eyebrow}" Margin="0,10,0,0" />
                                        <DatePicker x:Name="MemoryExpiryDatePicker" Margin="0,6,0,0"
                                                    AutomationProperties.AutomationId="MemoryExpiry" />
                                        <TextBlock x:Name="MemoryMetadataText" Text="来源：用户明确保存"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="SaveMemoryButton" Content="保存记忆"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="SaveMemoryButton_Click"
                                                    AutomationProperties.AutomationId="SaveMemory" />
                                            <Button x:Name="ToggleMemoryButton" Content="停用"
                                                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                                    IsEnabled="False" Click="ToggleMemoryButton_Click"
                                                    AutomationProperties.AutomationId="ToggleMemory" />
                                            <Button x:Name="DeleteMemoryButton" Content="删除"
                                                    Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                                                    IsEnabled="False" Click="DeleteMemoryButton_Click"
                                                    AutomationProperties.AutomationId="DeleteMemory" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                                        Margin="0,18,0,0" Padding="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="本地相关记忆预览" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="只在本机匹配；不会发送给模型。本地预览不代表同意出站。"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10"
                                                   TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="MemoryPreviewQueryTextBox" MaxLength="500"
                                                     VerticalContentAlignment="Center"
                                                     TextChanged="MemoryPreviewQueryTextBox_TextChanged"
                                                     AutomationProperties.AutomationId="MemoryPreviewQuery" />
                                            <ComboBox x:Name="MemoryPreviewProjectComboBox" Grid.Column="2"
                                                      DisplayMemberPath="Name"
                                                      SelectionChanged="MemoryPreviewProjectComboBox_SelectionChanged"
                                                      AutomationProperties.AutomationId="MemoryPreviewProject" />
                                            <Button Grid.Column="4" Content="预览匹配" Style="{StaticResource SecondaryButton}"
                                                    Click="RunMemoryPreviewButton_Click"
                                                    AutomationProperties.AutomationId="RunMemoryPreview" />
                                        </Grid>
                                        <TextBlock x:Name="MemoryPreviewSummaryText"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"
                                                   TextWrapping="Wrap" />
                                        <ListBox x:Name="MemoryPreviewResultsListBox" MaxHeight="260" Margin="0,8,0,0"
                                                 AutomationProperties.AutomationId="MemoryPreviewResults">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="3,5">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceBorder}" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="运行方式" FontSize="16" FontWeight="SemiBold" />
                                <CheckBox x:Name="StartWithWindowsCheckBox" Content="登录 Windows 后自动启动" Margin="0,14,0,0" />
                                <CheckBox x:Name="RunInBackgroundCheckBox" Content="关闭窗口后在后台运行客户端" Margin="0,10,0,0" />
                                <CheckBox x:Name="CloseToTrayCheckBox" Content="点击关闭按钮时收起到系统托盘" Margin="0,10,0,0" />
                                <CheckBox x:Name="NotificationsEnabledCheckBox" Content="显示任务完成、失败和等待决定的本地通知" Margin="0,10,0,0" />
                                <Button Content="保存设置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                        Margin="0,15,0,0" Click="SaveSettingsButton_Click" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceBorder}" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" />
                                    <RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" />
                                    <RowDefinition Height="44" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="本机中枢服务" VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsHostStatusText" Grid.Column="1" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="编程技能状态" VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsCodexStatusText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="编程工具版本" VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsCodexVersionText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" />
                                <TextBlock Grid.Row="3" Text="语音状态" VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsVoiceStatusText" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Text="数据库状态" VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsDatabaseStatusText" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="5" Text="本机 Device ID" VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsDeviceIdText" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" />
                                <TextBlock Grid.Row="6" Text="数据存储位置" VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsDataPathText" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SurfaceBorder}" Padding="20" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="数据管理" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="清理只删除已结束的任务历史，不会删除项目文件。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="清理历史记录" Style="{StaticResource DangerButton}" Click="ClearHistoryButton_Click" />
                                    <Button Content="打开数据目录" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OpenDataDirectoryButton_Click" />
                                    <Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OpenLogsDirectoryButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceBorder}" Padding="20" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="元枢 · 个人电脑 AI 中枢" Margin="0,8,0,0" />
                                <TextBlock x:Name="ProductVersionText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="3" Background="#E6ECEA" Padding="22,0">
                <TextBlock x:Name="StatusBarText" Text="正在连接本机中枢…" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </Border>
        </Grid>
    </Grid>
</Window>
